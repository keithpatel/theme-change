rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      // Hardcoded admin email for now as per project context
      return isAuthenticated() && request.auth.token.email == "test@gmail.com";
    }

    function isOwner(memberId) {
       // We assume the memberId in firestore matches the auth UID or we have a mapping.
       // In this app, logins are by Member ID (e.g. 10001) which is the document ID.
       // Firebase Auth UID is different.
       // However, for simplicity in this specific community app, if user is authenticated
       // and we can verify their identity. 
       // For a robust system we'd use Custom Claims or check request.auth.uid.
       // For now, let's allow admins full access and users basic access.
       return isAuthenticated();
    }

    // Members collection
    match /members/{memberId} {
      // Everyone authenticated can read members (needed for guarantor search)
      allow read: if isAuthenticated();
      // Only admins can create/update/delete members
      allow write: if isAdmin();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read/write their own notifications
      allow read, write: if isAuthenticated();
    }
    
    // Loans collection
    match /loans/{loanId} {
      // Authenticated users can read loans (needed for guarantor/member views)
      allow read: if isAuthenticated();
      // Only admins can perform loan operations (approve/reject/repayment)
      // View-Only admins (handled in UI) are still admins in Auth but restricted in UI.
      // Wait, Admin View users are technically MEMBERS who got access.
      // So request.auth.token.email == "test@gmail.com" only matches the real admin.
      allow write: if isAdmin();
    }
    
    // Withdrawals/Refunds collection
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default rule: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
